# Python
__pycache__/
*.py[cod]
*.pyo
.env
venv/
.venv/
*.egg-info/
dist/
build/

# Data — never commit raw datasets (too large)
data/raw/
data/processed/

# Model weights — never commit trained weights to git
models/vision/*.pth
models/audio/wav2vec2_ravdess/
models/text/roberta_goemotions/
models/fusion/*.pth

# Keep .gitkeep files so folder structure is preserved
!models/vision/.gitkeep
!models/audio/.gitkeep
!models/text/.gitkeep
!models/fusion/.gitkeep

# Streamlit
.streamlit/

# OS
.DS_Store
Thumbs.db

# Jupyter
.ipynb_checkpoints/
notebooks/.ipynb_checkpoints/

# Redis
dump.rdb

# Logs
*.log

# Gemini AI assistant cache
.gemini/
